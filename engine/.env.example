# Copy to .env and fill in. Never commit .env.

# Claude (the central AI + every sub-agent). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Airtable — the factory's memory / single source of truth
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Server
PORT=8080

# Guardrails — the hard limits the orchestrator will never exceed without a human.
# These mirror sales-factory/brain/03-pricing-and-terms.md. Fill from Dexter.
MAX_AUTO_DISCOUNT_PCT=0
MAX_AUTO_QUOTE_GBP=0
ALLOW_AUTO_CREDIT=false

# ============ CHANNEL FEEDS (revenue tiles) ============
# Add whichever you have; each channel is skipped until its creds are present.

# Shopify (retail) — Settings → Apps → Develop apps → Admin API access token
SHOPIFY_SHOP=            # e.g. febland.myshopify.com
SHOPIFY_TOKEN=           # shpat_...

# WooCommerce (trade portal) — WooCommerce → Settings → Advanced → REST API (read-only)
WOO_SITE=                # e.g. https://trade.febland.co.uk
WOO_KEY=                 # ck_...
WOO_SECRET=              # cs_...

# Amazon Selling Partner API — LWA app credentials + refresh token
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=A1F83G8C2ARO7P   # UK
AMAZON_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# eBay Sell API — OAuth user access token for the selling account
EBAY_OAUTH_TOKEN=
EBAY_ENDPOINT=https://api.ebay.com

# Faire (wholesale) — brand API access token
FAIRE_ACCESS_TOKEN=
FAIRE_ENDPOINT=https://www.faire.com/external-api/v2
