# Copy to .env and fill in. Never commit .env.

# Claude (the central AI + every sub-agent). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=

# Airtable — the factory's memory / single source of truth
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Server
PORT=8080

# Guardrails — the hard limits the orchestrator will never exceed without a human.
# These mirror sales-factory/brain/03-pricing-and-terms.md. Fill from Dexter.
MAX_AUTO_DISCOUNT_PCT=0
MAX_AUTO_QUOTE_GBP=0
ALLOW_AUTO_CREDIT=false
